{
  "schema_version": "mcp-tests-server-resource-policy-spec-v1",
  "spec_mode": "canonical_structured_spec_not_progress_log",
  "scope": "Cross-category resource policy grammar for MCP-callable tool invocation. Applies across profiles, tools, and authz decision. Not a CLI extension.",
  "applies_to": [
    "SERVER_PROFILES_SPEC.json",
    "SERVER_TOOLS_SPEC.json",
    "SERVER_AUTHZ_DECISION_SPEC.json"
  ],
  "runtime_enforced": true,
  "connector_visible": false,
  "resource_classes": {
    "public_index": {
      "description": "Read-only public search/fetch index exposed by the public surface.",
      "allowed_operations": [
        "read"
      ],
      "public_surface_allowed": true
    },
    "filesystem_public": {
      "description": "Read-only access to the configured public sandbox filesystem.",
      "allowed_operations": [
        "read",
        "list",
        "stat"
      ],
      "public_surface_allowed": true
    },
    "filesystem_workspace_readonly": {
      "description": "Read-only code/workspace inspection for developer/test profile with lexical and realpath containment, stable directory pagination, and bounded early-terminating text reads.",
      "allowed_operations": [
        "read",
        "list",
        "stat",
        "analyze"
      ],
      "public_surface_allowed": false
    },
    "filesystem_workspace_mutation": {
      "description": "Bounded authenticated workspace mutation inside configured writable roots with realpath/reparse-point enforcement, immediate pre-mutation revalidation, backup/trash/restore controls, and semantic append-only restrictions.",
      "allowed_operations": [
        "write"
      ],
      "public_surface_allowed": false
    },
    "network_allowlisted": {
      "description": "Read-only outbound HTTP(S) access restricted by allowlist, redirect limits, timeout, byte cap and SSRF guard.",
      "allowed_operations": [
        "read",
        "head",
        "metadata"
      ],
      "public_surface_allowed": true
    },
    "memory_context_scoped": {
      "description": "Scoped agent memory/state/task resource. Requires namespace and profile authorization.",
      "allowed_operations": [
        "read",
        "search",
        "write",
        "state_update",
        "task_create",
        "task_list",
        "task_update"
      ],
      "public_surface_allowed": false
    },
    "plugin_registry_readonly": {
      "description": "Read-only plugin registry/catalog metadata.",
      "allowed_operations": [
        "audit",
        "list",
        "read",
        "search"
      ],
      "public_surface_allowed": false
    },
    "plugin_visibility_state_preview": {
      "description": "Preview/planning resource for plugin visibility and hotplug lifecycle. No apply without separate approval.",
      "allowed_operations": [
        "plan",
        "preview",
        "read",
        "verify_receipt"
      ],
      "public_surface_allowed": false
    },
    "plugin_execution_readonly": {
      "description": "Read-only plugin execution governance/preflight/readonly execution receipt path.",
      "allowed_operations": [
        "preflight",
        "read",
        "readonly_execute",
        "verify_receipt"
      ],
      "public_surface_allowed": false
    },
    "auth_runtime_readonly": {
      "description": "Read-only auth transition/status/dry-run/guard resource.",
      "allowed_operations": [
        "read",
        "dry_run",
        "guard"
      ],
      "public_surface_allowed": false
    },
    "observability_audit_readonly": {
      "description": "Read-only runtime observability and audit summary resource.",
      "allowed_operations": [
        "read",
        "summarize"
      ],
      "public_surface_allowed": false
    },
    "tool_surface_planning": {
      "description": "Read-only or preview-only tool surface/session planning resource.",
      "allowed_operations": [
        "read",
        "plan"
      ],
      "public_surface_allowed": false
    },
    "runtime_tool_registry_readonly": {
      "description": "Read-only runtime registry/policy introspection for connector-visible tool metadata and dry-run governance.",
      "allowed_operations": [
        "read",
        "preflight",
        "plan",
        "readonly_execute"
      ],
      "public_surface_allowed": false
    },
    "workspace_index_readonly": {
      "description": "Read-only workspace retrieval helper index stored under TEST MCP control-plane state.",
      "allowed_operations": [
        "read",
        "search"
      ],
      "public_surface_allowed": false
    },
    "workspace_index_mutation": {
      "description": "Bounded authenticated workspace index rebuild/update under TEST MCP control-plane state.",
      "allowed_operations": [
        "write"
      ],
      "public_surface_allowed": false
    },
    "codebase_memory_readonly": {
      "description": "Authenticated read-only access to persisted codebase-memory project indexes through the fixed one-shot CLI bridge.",
      "allowed_operations": [
        "read",
        "list",
        "search"
      ],
      "public_surface_allowed": false
    },
    "codebase_memory_mutation": {
      "description": "Authenticated explicit repository indexing, ADR updates, and trace ingestion through the fixed codebase-memory CLI bridge, with one active mutation at a time.",
      "allowed_operations": [
        "write"
      ],
      "public_surface_allowed": false
    },
    "codebase_memory_destructive": {
      "description": "Authenticated destructive removal of one named codebase-memory project index. Repository source files are outside this operation.",
      "allowed_operations": [
        "delete"
      ],
      "public_surface_allowed": false,
      "destructive": true,
      "confirmation_required": true,
      "confirmation_kind": "cbm_delete_project_confirmation",
      "confirmation_ttl_ms": 120000,
      "source_repository_deletion": false
    },
    "runtime_status_readonly": {
      "description": "Read-only server runtime/status resource.",
      "allowed_operations": [
        "read"
      ],
      "public_surface_allowed": false
    },
    "process_execution_bounded": {
      "description": "Bounded authenticated process execution restricted by allowlist, cwd, timeout, output caps, and environment minimization.",
      "allowed_operations": [
        "execute"
      ],
      "public_surface_allowed": false
    },
    "database_store_bounded": {
      "description": "Reserved bounded database/state-store resource class. No raw SQL, no arbitrary connection strings, no migrations without operator approval.",
      "allowed_operations": [
        "read",
        "write",
        "plan",
        "migrate"
      ],
      "public_surface_allowed": false,
      "reserved": true
    },
    "remote_site_readonly": {
      "description": "Read-only remote-site SFTP inspection and retention-preview resource bounded by per-call config references and remote site/ops roots.",
      "allowed_operations": [
        "read",
        "list",
        "preview"
      ],
      "public_surface_allowed": false
    },
    "remote_site_mutation": {
      "description": "Authenticated remote-site SFTP mutation resource bounded by per-call config references, remote site/ops roots, soft-delete discipline, one shared operation context, metadata/log identity, and rollback attempts when post-rename audit persistence fails.",
      "allowed_operations": [
        "write"
      ],
      "public_surface_allowed": false
    }
  },
  "operation_classes": {
    "read": {
      "mutation": false
    },
    "list": {
      "mutation": false
    },
    "stat": {
      "mutation": false
    },
    "head": {
      "mutation": false
    },
    "metadata": {
      "mutation": false
    },
    "analyze": {
      "mutation": false
    },
    "search": {
      "mutation": false
    },
    "write": {
      "mutation": true
    },
    "delete": {
      "mutation": true,
      "destructive": true,
      "operator_approval_required": true
    },
    "state_update": {
      "mutation": true
    },
    "task_create": {
      "mutation": true
    },
    "task_list": {
      "mutation": false
    },
    "task_update": {
      "mutation": true
    },
    "plan": {
      "mutation": false
    },
    "preview": {
      "mutation": false
    },
    "dry_run": {
      "mutation": false
    },
    "guard": {
      "mutation": false
    },
    "preflight": {
      "mutation": false
    },
    "readonly_execute": {
      "mutation": false
    },
    "verify_receipt": {
      "mutation": false
    },
    "summarize": {
      "mutation": false
    },
    "migrate": {
      "mutation": true,
      "operator_approval_required": true
    },
    "audit": {
      "mutation": false
    },
    "execute": {
      "mutation": true
    }
  },
  "mandatory_rules": {
    "no_cli_extension": true,
    "unknown_resource_class_denied": true,
    "unknown_operation_class_denied": true,
    "public_surface_disallows_non_public_resource_classes": true,
    "mutating_operation_requires_audit": true,
    "database_raw_query_tools_forbidden": true,
    "resource_policy_refs_must_be_declared_in_profiles_when_profile_controls_resources": true,
    "workspace_realpath_containment_required": true,
    "workspace_mutation_link_components_denied": true,
    "bounded_read_work_required": true,
    "semantic_append_only_classification_required": true,
    "remote_mutation_operation_identity_required": true,
    "code_mutation_validation_capability_preflight_required": true
  },
  "profile_schema_fields": {
    "allowed_resource_policy_refs": "optional string array on each profile surface",
    "denied_resource_policy_refs": "optional string array on each profile surface"
  },
  "next_specific_specs": [
    "SERVER_MEMORY_POLICY_SPEC.json",
    "SERVER_NETWORK_POLICY_SPEC.json",
    "SERVER_DATABASE_POLICY_SPEC.json",
    "SERVER_PLUGIN_VISIBILITY_POLICY_SPEC.json"
  ],
  "memory_policy_ref": "SERVER_MEMORY_POLICY_SPEC.json",
  "specific_policy_refs": {
    "memory": "SERVER_MEMORY_POLICY_SPEC.json",
    "network": "SERVER_NETWORK_POLICY_SPEC.json",
    "database": "SERVER_DATABASE_POLICY_SPEC.json",
    "plugin_visibility": "SERVER_PLUGIN_VISIBILITY_POLICY_SPEC.json"
  },
  "network_policy_ref": "SERVER_NETWORK_POLICY_SPEC.json",
  "database_policy_ref": "SERVER_DATABASE_POLICY_SPEC.json",
  "plugin_visibility_policy_ref": "SERVER_PLUGIN_VISIBILITY_POLICY_SPEC.json",
  "policy_runtime_ref": "SERVER_POLICY_RUNTIME_SPEC.json",
  "sessionless_ready_review": {
    "status": "sessionless_ready_reviewed",
    "date": "2026-06-29",
    "source_of_truth": "_workflow/sessionless_inventory.json#target_selection_readiness",
    "workflow_record": "_workflow/operator_decisions/legacy_auth_cleanup_sessionless_ready_review.md",
    "guard": "_tests/smoke_legacy_archive_sessionless_ready_specs.js",
    "current_stable_route": "/mcp",
    "current_stable_route_status": "legacy_compatible_do_not_remove",
    "sessionless_transition_route": "/mcp/sessionless",
    "sessionless_transition_route_historical_only": true,
    "single_route_no_sse_target_record": "_workflow/operator_decisions/single_route_no_sse_streamable_http_target_plan.md",
    "sessionless_transition_env": "MCP_TEST_ENABLE_SESSIONLESS_PROTOTYPE",
    "root_spec_runtime_change": false,
    "connector_visible_surface_changed": false,
    "connector_refresh_required_now": false,
    "runtime_restart_required_now": false,
    "public_3009_start_required_now": false,
    "notes": "Root spec reviewed for sessionless-ready workflow posture; stable connector route remains unchanged and sessionless activation/migration remain separate explicit operator stages. The hidden /mcp/sessionless route is a historical transition route, not the final target architecture, and it is now retired from active repo runtime and confirmed absent on live OAuth21 3008 after the controlled restart.",
    "sessionless_transition_route_retired_from_active_runtime": true,
    "sessionless_transition_env_retired_from_active_runtime": true
  },
  "filesystem_hardening_contract": {
    "status": "verified_in_isolated_worktree",
    "local_read_contract": {
      "directory_default_limit": 100,
      "directory_max_limit": 500,
      "pagination": "stable_opaque_cursor_name_order",
      "partial_totals": "null_when_eof_not_observed",
      "work_bound": "requested_range_plus_one_probe_unit"
    },
    "local_mutation_contract": {
      "append_only_extensions": [
        ".log",
        ".jsonl",
        ".ndjson"
      ],
      "canonical_or_editable_text_append": "deny_and_direct_to_edit_file_patch",
      "allow_protected_bypasses_semantic_append_policy": false
    },
    "remote_mutation_contract": {
      "write_diff_path_calculated_once": true,
      "move_manifest_required": true,
      "manifest_log_result_identity_required": true,
      "audit_failure_after_move": "attempt_rename_rollback_and_report_outcome"
    },
    "code_patch_contract": {
      "analysis_without_checker_allowed_for_dry_run": true,
      "real_apply_without_checker": "validation_unavailable_before_backup_or_write",
      "network_checker_install_forbidden": true
    },
    "guards": [
      "_tests/smoke_workspace_fs_bounded.js",
      "_tests/smoke_workspace_realpath_boundary.js",
      "_tests/smoke_append_file_policy.js",
      "_tests/smoke_remote_site_mutation_audit.js",
      "_tests/smoke_code_patch_validation_capability.js"
    ]
  }
}
